DOUBAO_API_KEY=your_api_key
DOUBAO_RESOURCE_ID=volc.seedasr.sauc.duration
ASR_WS_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
ASR_BOOSTING_TABLE_ID=
PORT=3000

# === 声纹自动识别配置 ===
# 方案A（推荐，开源免费）: 本地部署声纹微服务
#   cd voiceprint-service && ./start.sh
#   默认监听 http://127.0.0.1:8001
VOICEPRINT_SERVICE_URL=http://127.0.0.1:8001

# 方案B（可选）: 腾讯云声纹API（云服务，按量付费）
# 如同时配置，方案A优先；不配VOICEPRINT_SERVICE_URL则启用方案B
# TENCENT_SECRET_ID=
# TENCENT_SECRET_KEY=
# TENCENT_REGION=ap-beijing
# TENCENT_VOICEPRINT_GROUP_ID=meeting_asr

# 声纹识别阈值（0-100分，建议70分以上）
VOICEPRINT_SCORE_THRESHOLD=70
# 累积多少毫秒有效语音后触发首次声纹匹配
VOICEPRINT_MIN_AUDIO_MS=2000
# 单说话人最大缓冲音频（毫秒，达到后强制匹配）
VOICEPRINT_MAX_AUDIO_MS=5000
